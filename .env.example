# ===== Supabase =====
# Dashboard de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ¡NUNCA usar en el cliente! Solo API routes / webhooks / cron.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (para back_urls y notificación del webhook)
NEXT_PUBLIC_URL=http://localhost:3000

# ===== Mercado Pago =====
# Credenciales de prueba o producción (ver README)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Secreto del webhook configurado en el panel de Mercado Pago
MP_WEBHOOK_SECRET=

# ===== Cron (Vercel) =====
# Secreto que protege /api/cron/release-reservations
CRON_SECRET=

# ===== Panel de administración (/admin/verify) =====
# Clave maestra de 25 caracteres guardada SOLO como hash SHA-256 (hex de 64).
# Generar el hash (Node):
#   node -e "console.log(require('crypto').createHash('sha256').update('TU_CLAVE').digest('hex'))"
# Generar el hash (PowerShell):
#   $s='TU_CLAVE'; [BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash([Text.Encoding]::UTF8.GetBytes($s))).Replace('-','').ToLower()
ADMIN_ACCESS_CODE_HASH=
# Opcional: secreto independiente para firmar la cookie admin_verified.
# Si se omite, se deriva del hash del código maestro.
ADMIN_SESSION_SECRET=

# ===== Sentry (monitoreo de errores) =====
# DSN público del proyecto: Sentry > Settings > Projects > <proyecto> > Client Keys (DSN).
# Si queda vacío, el SDK no envía nada y la app funciona igual.
NEXT_PUBLIC_SENTRY_DSN=
# Opcional: fracción de trazas a muestrear (0 a 1). Por defecto 0.1.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Solo se usa en el build (source maps). NUNCA en el cliente.
# Sentry > Settings > Auth Tokens (scope: project:releases).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=gadu-sorteos
SENTRY_PROJECT=gadu-sorteos
